# ===========================================
# ALFRED - AI Chief of Staff
# Copy this file to .env and fill in your keys
# ===========================================

# Anthropic (REQUIRED) - console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Slack (REQUIRED) - api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-xxxxx
SLACK_SIGNING_SECRET=xxxxx
SLACK_APP_TOKEN=xapp-xxxxx

# Brave Search (REQUIRED for research) - brave.com/search/api
BRAVE_SEARCH_API_KEY=BSAxxxxx

# OpenAI Whisper (OPTIONAL - for voice notes) - platform.openai.com
OPENAI_API_KEY=sk-xxxxx

# Alpaca (OPTIONAL - for market data) - alpaca.markets
ALPACA_API_KEY=xxxxx
ALPACA_SECRET_KEY=xxxxx

# Alfred Settings
ALFRED_WAKE_TIME=10:00
ALFRED_TIMEZONE=Asia/Kolkata
ALFRED_DAILY_TOKEN_BUDGET=500000
ALFRED_LOG_LEVEL=INFO
